{
  "name": "courier",
  "productName": "Courier",
  "version": "0.1.0",
  "description": "Postman-style API client with Azure identity sign-in and Azure Blob Storage sharing",
  "license": "MIT",
  "author": "Courier contributors",
  "main": "out/main/index.js",
  "bin": {
    "courier": "out/cli/courier.cjs"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:cli",
    "build:cli": "vite build --config cli.vite.config.mts",
    "cli": "node out/cli/courier.cjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && node e2e/drive.mjs && node e2e/cli.mjs",
    "smoke:engine": "npm run build && node e2e/engine-smoke.mjs",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/keyvault-secrets": "^4.12.0",
    "@azure/storage-blob": "^12.34.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@grpc/grpc-js": "^1.14.7",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "protobufjs": "^8.8.1",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tough-cookie": "^6.1.0",
    "undici": "^7.30.2",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@grpc/proto-loader": "^0.8.1",
    "@grpc/reflection": "^1.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "azurite": "^3.38.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
